[Unit]
Description=gfs — groot files share (VPS door)
Documentation=https://github.com/hrodrig/groot-share
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gfs
Group=gfs
# Defense in depth (CVE-2026-98432). Kernel patch still required — see SECURITY.md.
Environment=GODEBUG=multipathtcp=0
EnvironmentFile=/etc/gfs/gfs.env
ExecStart=/usr/local/bin/gfs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/gfs

[Install]
WantedBy=multi-user.target
